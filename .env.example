# Ключ Claude API для ИИ-оценки (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Vercel Blob — хранилище данных объявлений (создаётся в Vercel: Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Необязательно: кнопка «Обновить» на сайте запускает сбор в GitHub Actions
GITHUB_REPO=username/repo
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Необязательно: лимит ИИ-оценок с одного IP в час (по умолчанию 20)
ASSESS_LIMIT_PER_HOUR=20
